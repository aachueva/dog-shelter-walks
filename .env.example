# Recommended: the ID between /d/ and /edit in your Google Sheet URL.
# The spreadsheet must be shared as "Anyone with the link can view".
GOOGLE_SHEET_ID=

# These defaults match the supplied workbook.
CURRENT_DOGS_TAB=Current Dogs
WALKS_TAB=Walks

# Alternative: set two complete public CSV URLs instead of GOOGLE_SHEET_ID.
GOOGLE_SHEET_CURRENT_DOGS_CSV_URL=
GOOGLE_SHEET_WALKS_CSV_URL=

# Number of dogs featured in the "Top priority" section.
DAILY_PRIORITY_COUNT=3

# Avoid two Google requests on every phone load while keeping data fresh.
DATA_CACHE_SECONDS=300

# The shelter's local timezone determines when the dashboard changes days.
SHELTER_TIMEZONE=America/Los_Angeles

# Server port (Render and other hosts set this automatically)
PORT=8080

# Bind address. Use 0.0.0.0 for public web hosting.
HOST=0.0.0.0
