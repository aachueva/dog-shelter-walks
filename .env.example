# Full Google Sheets CSV export URL.
# Share the sheet as "Anyone with the link can view", then use:
# https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/export?format=csv&gid=YOUR_TAB_GID
#
# Supports both layouts:
# - Two columns: Dog Name, Date of Walk
# - Wide matrix: dog names in column A, walk dates across the row
GOOGLE_SHEET_CSV_URL=

# Dogs with fewer than this many walks in a week are flagged as underwalked.
UNDERWALKED_THRESHOLD=1

# Server port (Render and other hosts set this automatically)
PORT=8080

# Bind address. Use 0.0.0.0 for public web hosting.
HOST=0.0.0.0
